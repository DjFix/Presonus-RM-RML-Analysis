.DS_Store
rootfs/
/.backups/

# Project trash: preserve until explicitly approved for permanent deletion.
/.trashes/

# Local recovery work and evidence (preserved on disk, not versioned).
/temp/
/evidence/

# Local environments, generated builds and caches.
.venv/
venv/
__pycache__/
*.py[cod]
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
CTestTestfile.cmake
compile_commands.json
Testing/

# Compiled objects, libraries, executables and native run outputs.
*.o
*.obj
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe
*.out
*.elf
*.bin
*.log
*.stdout
*.stderr
*.dSYM/

# Worker delivery/admission metadata stays local; regression fixtures stay versioned.
/uc-library/candidates/**/HANDOFF*.json
/uc-library/candidates/**/handoff*.json
/uc-library/candidates/**/work-log.json
/uc-library/candidates/**/delivery.json
/uc-library/candidates/**/*proof*.json
/uc-library/candidates/**/pending.json
/uc-library/candidates/**/pending.fragment.json
/uc-library/candidates/**/ready.fragment.json

# Reports stay local even if a producer places them outside the usual folders.
**/FINAL_SOURCE_DRIFT*.json
**/SOURCE_DRIFT_PRECHECK*.json
**/HANDOFF_INPUTS*.json
**/STAGED_REVIEW*.json
**/COMMIT_INPUT_PLAN*.json
# Existing replay inputs in these historical locations are enumerated in
# tools/git-artifact-policy.json; do not use broad force-add to override ignores.
/uc-library/candidates/**/*.json
/uc-library/candidates/**/*.jsonl
/uc-library/tracking/coverage.json
