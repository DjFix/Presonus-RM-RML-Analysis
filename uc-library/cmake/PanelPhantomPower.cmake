 file(MAKE_DIRECTORY "${_phantom_work}")
 configure_file("${CMAKE_CURRENT_SOURCE_DIR}/validation/panel-phantom-power/fixtures.txt" "${_phantom_work}/fixtures.txt" COPYONLY)
 add_executable(panel_phantom_power_tests tests/panel_phantom_power_tests.cpp $<TARGET_OBJECTS:panel_hal_core_rtti>)
 target_compile_options(panel_phantom_power_tests PRIVATE -frtti -fno-lto -fno-fast-math -ffp-contract=off -UNDEBUG)
 target_link_options(panel_phantom_power_tests PRIVATE -Wl,--wrap=_ZN4Core8Portable9Parameter14removeObserverEPNS0_14IParamObserverE)
