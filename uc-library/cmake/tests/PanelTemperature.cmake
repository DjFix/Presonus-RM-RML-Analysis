# Test-only registration. Keep production source properties outside this directory.
if(BUILD_TESTING)
 if(NOT TARGET panel_hal_core_rtti)
  message(FATAL_ERROR "Existing genuine test-only CCL parameter provider required")
 endif()
 set(_temperature_work "${PRESONUS_REPOSITORY_ROOT}/temp/test-work/panel-temperature")
 file(MAKE_DIRECTORY "${_temperature_work}")
 configure_file("${CMAKE_CURRENT_SOURCE_DIR}/validation/panel-temperature/fixtures.txt" "${_temperature_work}/fixtures.txt" COPYONLY)
 add_executable(panel_temperature_tests tests/panel_temperature_tests.cpp $<TARGET_OBJECTS:panel_hal_core_rtti>)
 target_compile_options(panel_temperature_tests PRIVATE -frtti -fno-lto -fno-fast-math -ffp-contract=off -UNDEBUG)
 target_link_libraries(panel_temperature_tests PRIVATE stdc++ presonus::uc)
 add_test(NAME panel_temperature_tests COMMAND panel_temperature_tests "${_temperature_work}/fixtures.txt")
 set_tests_properties(panel_temperature_tests PROPERTIES WORKING_DIRECTORY "${_temperature_work}")
endif()

